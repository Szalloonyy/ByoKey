        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spokojne miejsce pracy dla modeli AI – z twoim własnym kluczem API i podglądem kosztów, który niczego przed tobą nie ukrywa."
          }
        }
      }
    },
    "Eine kürzere Antwortlänge begrenzt die Kosten pro Anfrage zuverlässiger als jede Schätzung." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
