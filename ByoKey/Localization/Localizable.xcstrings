    "Chats, Projekte und Einstellungen wurden gelöscht. " : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats, projects and settings have been deleted. "
          }
        },
        "pl" : {
          "stringUnit" : {
