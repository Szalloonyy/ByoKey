    },
    "Damit ein KI-Modell antworten kann, muss der Text dein Gerät verlassen. Ohne deine Zustimmung sendet ByoKey nichts." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
