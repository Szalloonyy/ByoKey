    "Wird jedem Chat dieses Projekts vorangestellt. Die verbindlichen Sicherheitsregeln der App bleiben davon unberührt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is prepended to every chat in this project. The app’s binding safety rules remain unaffected by it."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest dodawany na początku każdego czatu w tym projekcie. Wiążące zasady bezpieczeństwa aplikacji pozostają nienaruszone."
          }
        }
      }
    },
