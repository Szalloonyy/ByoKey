        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt grupuje czaty i nadaje im stały prompt systemowy oraz domyślny model."
          }
        }
      }
    },
    "Ein ruhiger Arbeitsplatz für KI-Modelle – mit deinem eigenen API-Schlüssel und einer Kostenanzeige, die dir nichts verschweigt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
