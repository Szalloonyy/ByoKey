    "Sexualisierung Minderjähriger" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sexualization of minors"
          }
        },
        "pl" : {
