    " Dazu kommen %@ Code-Blöcke, die du am besten liest." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " There are also %@ code blocks that you should read yourself."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Do tego dochodzą bloki kodu (%@), które najlepiej przeczytać samodzielnie."
          }
        }
      }
    },
    " Dazu kommt ein Code-Block, den du am besten liest." : {
      "extractionState" : "manual",
