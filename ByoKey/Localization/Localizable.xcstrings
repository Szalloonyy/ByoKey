    "%@ bietet keine Sprach-Endpunkte. " : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does not offer voice endpoints. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie udostępnia punktów końcowych dla mowy. "
          }
        }
      }
    },
    "%@ bietet keine Sprach-Endpunkte. Nutze den Sprachmodus „Auf dem Gerät“ oder wähle einen Anbieter mit Audio-Unterstützung." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does not offer voice endpoints. Use the “On device” voice mode or choose a provider with audio support."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie udostępnia punktów końcowych dla mowy. Użyj trybu głosowego „Na urządzeniu” albo wybierz dostawcę z obsługą audio."
          }
        }
      }
    },
    "%@ bietet keine Sprach-Endpunkte. Stelle auf „Auf dem Gerät“ um." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does not offer voice endpoints. Switch to “On device”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie udostępnia punktów końcowych dla mowy. Przełącz na „Na urządzeniu”."
          }
        }
      }
    },
    "%@ bietet keine Sprach-Endpunkte. Stelle in den Einstellungen auf „Auf dem Gerät“ um." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does not provide speech endpoints. Switch to “On device” in Settings."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie udostępnia punktów końcowych mowy. Przełącz w Ustawieniach na „Na urządzeniu”."
          }
        }
      }
    },
    "%@ erzeugt keine Bilder. Wähle einen Anbieter mit Bildmodellen oder ein Modell, das Bilder ausgeben kann." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does not create images. Choose a provider with image models, or a model that can output images."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie tworzy obrazów. Wybierz dostawcę z modelami obrazu albo model, który potrafi zwracać obrazy."
          }
        }
      }
    },
    "%@ kennt beim Erzeugen von Bildern keine eigenen Vorlagen. Die Anfrage würde abgelehnt. Entferne das Bild – oder wechsle in den Einstellungen zu einem Anbieter, der Vorlagen unterstützt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ does not support your own reference images when generating images. The request would be rejected. Remove the image — or switch to a provider that supports references in Settings."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie obsługuje własnych obrazów referencyjnych przy generowaniu obrazów. Żądanie zostałoby odrzucone. Usuń obraz albo przełącz się w Ustawieniach na dostawcę, który obsługuje referencje."
          }
        }
      }
    },
    "%@ Kontext" : {
